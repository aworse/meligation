from __future__ import annotations
 
import argparse
import csv
import hashlib
import json
import os
import sys
import wave
from dataclasses import dataclass, asdict
from pathlib import Path
 
import numpy as np
 
MEL_SPEC_VERSION = "1.0"
 
 
# --------------------------------------------------------------------------- #
# 규격
# --------------------------------------------------------------------------- #
@dataclass(frozen=True)
class Regime:
    sample_rate: int = 48000
    n_fft: int = 1024
    win_length: int = 384        # 8 ms @48k
    hop_length: int = 96         # 2 ms @48k
    n_mels: int = 64
    fmin: float = 200.0
    fmax: float = 20000.0
    pre_ms: float = 5.0          # onset 앞
    post_ms: float = 95.0        # onset 뒤
    frames: int = 48
    log_eps: float = 1e-6
 
    @property
    def pre_samples(self) -> int:
        return int(round(self.pre_ms * self.sample_rate / 1000))
 
    @property
    def clip_samples(self) -> int:
        return int(round((self.pre_ms + self.post_ms) * self.sample_rate / 1000))  # 4800
 
    def param_hash(self) -> str:
        """키 정렬·공백 없는 canonical JSON -> SHA-256 앞 8자.
        NOTE: 키 이름/구성은 classism Regime의 해시 입력과 반드시 동일해야 한다.
        어긋나면 아래 canonical_dict()만 classism 쪽 정의에 맞춰 고치면 된다.
        """
        blob = json.dumps(self.canonical_dict(), sort_keys=True, separators=(",", ":"))
        return hashlib.sha256(blob.encode("utf-8")).hexdigest()[:8]
 
    def canonical_dict(self) -> dict:
        return asdict(self)
 
 
# --------------------------------------------------------------------------- #
# 멜 변환 (librosa 기본값과 동일한 수식)
# --------------------------------------------------------------------------- #
def _hz_to_mel(f):
    """Slaney: 1000Hz 미만 선형, 이상 로그."""
    f = np.asarray(f, dtype=np.float64)
    f_sp = 200.0 / 3
    mels = f / f_sp
    min_log_hz = 1000.0
    min_log_mel = min_log_hz / f_sp
    logstep = np.log(6.4) / 27.0
    return np.where(f >= min_log_hz,
                    min_log_mel + np.log(np.maximum(f, 1e-10) / min_log_hz) / logstep,
                    mels)
 
 
def _mel_to_hz(m):
    m = np.asarray(m, dtype=np.float64)
    f_sp = 200.0 / 3
    freqs = f_sp * m
    min_log_hz = 1000.0
    min_log_mel = min_log_hz / f_sp
    logstep = np.log(6.4) / 27.0
    return np.where(m >= min_log_mel,
                    min_log_hz * np.exp(logstep * (m - min_log_mel)),
                    freqs)
 
 
def mel_filterbank(sr: int, n_fft: int, n_mels: int, fmin: float, fmax: float) -> np.ndarray:
    """(n_mels, n_fft//2+1) 삼각 필터뱅크, Slaney 면적 정규화."""
    fft_freqs = np.linspace(0, sr / 2, 1 + n_fft // 2)
    mel_pts = np.linspace(_hz_to_mel(fmin), _hz_to_mel(fmax), n_mels + 2)
    hz_pts = _mel_to_hz(mel_pts)
    fdiff = np.diff(hz_pts)
    ramps = hz_pts[:, None] - fft_freqs[None, :]
    lower = -ramps[:-2] / fdiff[:-1, None]
    upper = ramps[2:] / fdiff[1:, None]
    weights = np.maximum(0.0, np.minimum(lower, upper))
    enorm = 2.0 / (hz_pts[2:n_mels + 2] - hz_pts[:n_mels])
    weights *= enorm[:, None]
    return weights.astype(np.float32)
 
 
class MelExtractor:
    """오프라인(학습)·온디바이스 레퍼런스 공용. 입력: 정확히 100ms 창(float32, [-1,1])."""
 
    def __init__(self, regime: Regime = Regime()):
        self.r = regime
        r = regime
        # librosa: 주기적(periodic) Hann 을 n_fft 길이로 가운데 패딩
        n = np.arange(r.win_length)
        win = 0.5 - 0.5 * np.cos(2 * np.pi * n / r.win_length)
        pad_l = (r.n_fft - r.win_length) // 2
        self.window = np.zeros(r.n_fft, dtype=np.float32)
        self.window[pad_l:pad_l + r.win_length] = win
        self.fb = mel_filterbank(r.sample_rate, r.n_fft, r.n_mels, r.fmin, r.fmax)
 
    def logmel(self, clip: np.ndarray) -> np.ndarray:
        """clip: (clip_samples,) float32 -> (n_mels, frames) float32, per-clip z-score 완료."""
        r = self.r
        if clip.shape[0] != r.clip_samples:
            raise ValueError(f"clip length {clip.shape[0]} != {r.clip_samples}")
        x = np.pad(clip.astype(np.float32), r.n_fft // 2, mode="reflect")  # center=True
        n_frames = 1 + (x.shape[0] - r.n_fft) // r.hop_length
        idx = np.arange(r.n_fft)[None, :] + r.hop_length * np.arange(n_frames)[:, None]
        spec = np.fft.rfft(x[idx] * self.window[None, :], axis=1)
        power = (spec.real ** 2 + spec.imag ** 2).astype(np.float32)       # (T, F)
        mel = self.fb @ power.T                                            # (n_mels, T)
        lm = np.log(mel + r.log_eps)
 
        lm = _fix_frames(lm, r.frames)
        std = lm.std()
        lm = (lm - lm.mean()) / (std if std > 1e-8 else 1.0)
        return lm.astype(np.float32)
 
 
def _fix_frames(a: np.ndarray, frames: int) -> np.ndarray:
    """시간축을 frames 로 고정: 길면 중앙 크롭, 짧으면 가장자리 패딩."""
    t = a.shape[1]
    if t > frames:
        s = (t - frames) // 2
        return a[:, s:s + frames]
    if t < frames:
        extra = frames - t
        l = extra // 2
        return np.pad(a, ((0, 0), (l, extra - l)), mode="edge")
    return a
 
 
def cut_window(wav: np.ndarray, onset_s: float, r: Regime):
    """onset-5ms ~ onset+95ms 를 잘라 반환. 못 담으면 (None, 사유)."""
    start = int(round(onset_s * r.sample_rate)) - r.pre_samples
    end = start + r.clip_samples
    if start < 0:
        return None, f"앞 부족(start={start} 샘플 < 0)"
    if end > wav.shape[0]:
        return None, f"뒤 부족(end={end} > len={wav.shape[0]})"
    return wav[start:end], None
 
 
def quantize_int8(logmel: np.ndarray, scale: float, zero_point: int) -> np.ndarray:
    """온디바이스 경로: AFE가 export 때 준 input_scale/zp 로 int8 변환."""
    q = np.round(logmel / scale) + zero_point
    return np.clip(q, -128, 127).astype(np.int8)
 
 
# --------------------------------------------------------------------------- #
# WAV I/O
# --------------------------------------------------------------------------- #
def load_wav_float(path: Path, expect_sr: int) -> np.ndarray:
    with wave.open(str(path), "rb") as w:
        sr, ch, sw, n = w.getframerate(), w.getnchannels(), w.getsampwidth(), w.getnframes()
        raw = w.readframes(n)
    if sw != 2:
        raise ValueError(f"PCM16 아님(sampwidth={sw})")
    if sr != expect_sr:
        raise ValueError(f"샘플레이트 {sr} != {expect_sr}")
    x = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
    if ch > 1:
        x = x.reshape(-1, ch).mean(axis=1)
    return x
 
 
# --------------------------------------------------------------------------- #
# 세션 단위 빌드
# --------------------------------------------------------------------------- #
def build_session(csv_path: Path, root_in: Path, root_out: Path, ext: MelExtractor):
    r = ext.r
    session = csv_path.stem
    mel_dir = root_out / "mel"
    mel_dir.mkdir(parents=True, exist_ok=True)
 
    ok, skipped = 0, []
    with open(csv_path, newline="", encoding="utf-8-sig") as f:
        rows = list(csv.DictReader(f))
 
    for row in rows:
        cid = row["clip_id"]                       # 글자 그대로 사용
        try:
            onset = float(row["wav_onset_s"])
        except (KeyError, ValueError):
            skipped.append((cid, "wav_onset_s 없음/비정상"))
            continue
        wav_path = root_in / "audio" / f"{cid}.wav"
        if not wav_path.is_file():
            skipped.append((cid, "wav 파일 없음"))
            continue
        try:
            wav = load_wav_float(wav_path, r.sample_rate)
        except Exception as e:                     # noqa: BLE001
            skipped.append((cid, f"wav 로드 실패: {e}"))
            continue
 
        clip, why = cut_window(wav, onset, r)
        if clip is None:
            skipped.append((cid, why))
            continue
 
        lm = ext.logmel(clip)
        assert lm.shape == (r.n_mels, r.frames) and lm.dtype == np.float32
 
        # 원자적 쓰기(재실행 멱등: 같은 clip_id 파일만 덮어씀)
        # 주의: np.save는 확장자가 .npy가 아니면 붙여버리므로 파일 핸들로 저장
        final = mel_dir / f"{cid}.npy"
        tmp = mel_dir / f"{cid}.npy.tmp"
        with open(tmp, "wb") as fh:
            np.save(fh, lm)
        os.replace(tmp, final)
        ok += 1
 
        if row.get("onset_source") == "prompt":
            pass  # 품질 낮음 표시는 CSV(측정기 소관)에 이미 있음. Mel은 그대로 처리.
 
    # 건너뛴 클립은 조용히 누락하지 않고 사유 기록 (세션별 파일, 재실행 시 덮어씀)
    rep = mel_dir / f"_skipped_{session}.csv"
    if skipped:
        with open(rep, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["clip_id", "reason"])
            w.writerows(skipped)
    elif rep.exists():
        rep.unlink()
 
    return session, len(rows), ok, skipped
 
 
def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="mel-build", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--in", dest="inp", required=True, type=Path, help="<root> (labels/, audio/)")
    ap.add_argument("--out", dest="out", type=Path, default=None, help="<root> (mel/ 생성). 기본=--in")
    ap.add_argument("--session", help="특정 세션 CSV 이름(확장자 제외)만 처리")
    args = ap.parse_args(argv)
 
    root_in = args.inp
    root_out = args.out or args.inp
    csvs = sorted((root_in / "labels").glob("*.csv"))
    if args.session:
        csvs = [p for p in csvs if p.stem == args.session]
    if not csvs:
        print("labels/*.csv 없음", file=sys.stderr)
        return 2
 
    regime = Regime()
    ext = MelExtractor(regime)
    ph = regime.param_hash()
 
    # 메타: classism이 자신의 regime 해시와 대조할 수 있도록 (npy 아님 -> 로더가 무시)
    (root_out / "mel").mkdir(parents=True, exist_ok=True)
    meta = {"mel_spec_version": MEL_SPEC_VERSION, "param_hash": ph,
            "sample_rate": regime.sample_rate, "n_mels": regime.n_mels,
            "frames": regime.frames, "regime": regime.canonical_dict()}
    with open(root_out / "mel" / "_meta.json", "w", encoding="utf-8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=2, sort_keys=True)
 
    total = total_ok = total_skip = 0
    for p in csvs:
        session, n, ok, skipped = build_session(p, root_in, root_out, ext)
        total, total_ok, total_skip = total + n, total_ok + ok, total_skip + len(skipped)
        print(f"[{session}] 행 {n} → 생성 {ok}, 건너뜀 {len(skipped)}")
        for cid, why in skipped:
            print(f"    SKIP {cid}: {why}")
 
    print(f"완료: 전체 {total}, 생성 {total_ok}, 건너뜀 {total_skip}, param_hash={ph}")
    return 0
 
 
if __name__ == "__main__":
    sys.exit(main())
